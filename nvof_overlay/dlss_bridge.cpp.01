    Texture(motion,rw,rh,DXGI_FORMAT_R16G16_FLOAT,read);Texture(depth,rw,rh,DXGI_FORMAT_R32_FLOAT,read);
    Texture(result,w,h,DXGI_FORMAT_R16G16B16A16_FLOAT,D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
    auto sourceDesc=source->GetDesc();
