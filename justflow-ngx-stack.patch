+    // Fail closed when NGX Frame Warp is unavailable: never pass off a shader as Reflex 2.
+    if (!f->lwf || !f->lw_final[0] || !f->lw_final[1]) return Fail(f, "NGX Frame Warp missing");
+    LARGE_INTEGER now; QueryPerformanceCounter(&now);
+    float sx = 0.0f, sy = 0.0f;
+    // Only use actual mouse counts accumulated since the photographed frame, calibrated against
+    // NvOFA optical flow. Do not estimate future input or extrapolate scene/object movement.
+    const bool reliable = s->cap_qpc && MouseMeasuredShiftStrict(s->cap_qpc, now.QuadPart, sx, sy);
+    const float magnitude = hypotf(sx, sy);
+    constexpr float kMinWarpPx = 0.35f;
+    constexpr float kMaxWarpPx = 2.0f;  // native-quality priority, at 1080p
+    if (!reliable || magnitude < kMinWarpPx || !std::isfinite(magnitude))
+    {
+        ++f->lw_skipped;
+        return PresentAfter(f, src, s, real, ready_fence, ready_value);
+    }
+    if (magnitude > kMaxWarpPx) { const float factor = kMaxWarpPx / magnitude; sx *= factor; sy *= factor; }
+
+    Gpu& g = *f->g;
+    if (!GpuCtxBegin(g, f->ctx)) return Fail(f, "NGX Frame Warp queue begin");
+    ID3D12GraphicsCommandList* cl = f->ctx.list;
+    ID3D12Resource* dst = f->lw_final[f->lw_next++ & 1];
+    OverlayGuard(f->ov, f->ctx.queue);  // previous present has stopped reading the output buffer
+    GpuBarrier(cl, src, CSRC, NPSR);
+    GpuBarrier(cl, dst, CSRC, UAV);
+    const float focal = f->h * 0.5f / tanf(f->lw_vfov * 0.5f);
