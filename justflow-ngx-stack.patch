--- /dev/null
+++ b/RUN-NGX-STACK-CS2.cmd
@@ -0,0 +1,16 @@
+@echo off
+setlocal
+cd /d "%~dp0"
+set JF_NGX_STACK_LW=1
+if not exist nvngx_latewarp.dll (
+    echo NVIDIA nvngx_latewarp.dll is required next to this launcher.
+    pause
+    exit /b 1
+)
+if not exist nvngx_dlssg.dll (
+    echo NVIDIA nvngx_dlssg.dll is required next to this launcher.
+    pause
+    exit /b 1
+)
+start "" "justflow.exe" --ini "profiles\cs2_ngx_test.ini"
+endlocal
