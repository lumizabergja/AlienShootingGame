diff --git a/src/mouse.cpp b/src/mouse.cpp
index 06a74b4..7a571a1 100644
--- a/src/mouse.cpp
+++ b/src/mouse.cpp
@@ -170,3 +170,29 @@ bool MousePredict(LONGLONG t_frame, LONGLONG t_now, float& sx, float& sy)
     for (int k = 0; k < 2; ++k) if (fit[k].ok) { sx += (float)(fit[k].gx * c[k][0]); sy += (float)(fit[k].gy * c[k][1]); }
     return true;
 }
+
+bool MouseMeasuredShiftStrict(LONGLONG t_frame, LONGLONG t_now, float& sx, float& sy)
+{
+    sx = sy = 0;
+    if (!t_frame || t_now <= t_frame) return false;
+    const double age_ms = 1000.0 * (t_now - t_frame) / QpcFreq();
+    if (age_ms > 60.0) return false; // captured frame is too old for a conservative correction
+    std::lock_guard<std::mutex> lk(mu);
+    constexpr double kMinimumR2 = 0.92;
+    constexpr int kMinimumObservations = 40;
+    const bool trusted[2] = {
+        fit[0].ok && fit[0].r2 >= kMinimumR2 && fit[0].n >= kMinimumObservations,
+        fit[1].ok && fit[1].r2 >= kMinimumR2 && fit[1].n >= kMinimumObservations
+    };
+    if (!trusted[0] && !trusted[1]) return false;
+    double c[2][2];
+    Sum(t_frame - (LONGLONG)(delay_ms * QpcFreq() / 1000.0), t_now, c);
+    // Never borrow movement from a class whose fit is not trustworthy. This avoids cursor movements
+    // in third-person games becoming false camera rotations.
+    for (int k = 0; k < 2; ++k) if (trusted[k])
+    {
+        sx += (float)(fit[k].gx * c[k][0]);
+        sy += (float)(fit[k].gy * c[k][1]);
+    }
+    return true;
+}
