+    ID3D12Fence* const ready_fence = evaluated ? f->ctx.fence : f->g->fence;
+    const UINT64 ready_value = evaluated ? s->eval_fence : s->fence;
+    if (!f->stacked_lw) return PresentAfter(f, src, s, real, ready_fence, ready_value);
