+    // live on the same D3D12 device. This is not a second capture or a second compositor.
+    const bool ok = LatewarpEvaluate(f->lwf, cl, src, dst, true,
+        atanf(-sx / focal), atanf(-sy / focal), 0.0f, f->lw_vfov, s->mask_ok ? s->mask : nullptr);
+    GpuBarrier(cl, dst, UAV, CSRC);
+    GpuBarrier(cl, src, NPSR, CSRC);
+    if (ok) CopyRects(f, cl, s, src, dst);  // keep fonts, crosshair, UI crisp
+    f->ctx.queue->Wait(ready_fence, ready_value);
+    const UINT64 warp_done = GpuCtxEnd(f->ctx);
+    if (!ok || !warp_done) return Fail(f, "genuine NGX Frame Warp evaluation failed");
+    ++f->lw_warped;
+    if (f->lw_warped % 240 == 1)
+        Log("[fg] NGX Frame Warp applied to real+generated output: warped=%u skipped=%u clamp=%.1fpx",
+            f->lw_warped, f->lw_skipped, kMaxWarpPx);
+    return PresentAfter(f, dst, s, real, f->ctx.fence, warp_done);
 }
 
