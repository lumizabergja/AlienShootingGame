+++ b/profiles/cs2_ngx_test.ini
@@ -0,0 +1,37 @@
+; Experimental native-looking NVIDIA NGX DLSS-G + NGX Frame Warp test.
+; This is a JustFlow-based feasibility build, NOT the original NvFBC V39 pipeline.
+; Select borderless-windowed CS2; there is no injection or game memory access.
+[capture]
+mode=dda
+window_title=Counter-Strike 2
+window_class=
+cursor=0
+border=0
+
+[nr]
+work=1920x1080
+max_fps=0
+
+[filters]
+sharpen=0
+saturation=1
+
+[ofa]
+input=960x540
+grid=4
+zero_below=0.5
+
+[ui]
+mask=0
+feather=0
+
+[fg]
+engine=dlssg
+multiplier=4
+pacing=vblank
+lw_fov=60
+min_gain=0
+max_input_fps=0
+
+[log]
+file=justflow.ngx-stack-cs2.log
