 auto upload=[&](ID3D12Resource* dst,const std::vector<uint8_t>& data,UINT tightPitch){auto desc=dst->GetDesc();D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout{};UINT rows{};UINT64 bytes{},size{};device->GetCopyableFootprints(&desc,0,1,0,&layout,&rows,&bytes,&size);auto src=buffer(size,D3D12_HEAP_TYPE_UPLOAD,D3D12_RESOURCE_STATE_GENERIC_READ);void* mapped{};check(src->Map(0,nullptr,&mapped),"Test upload map");for(UINT y=0;y<rows;++y)memcpy((uint8_t*)mapped+layout.Offset+y*layout.Footprint.RowPitch,data.data()+y*tightPitch,tightPitch);src->Unmap(0,nullptr);D3D12_TEXTURE_COPY_LOCATION a{},b{};a.pResource=dst;a.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;b.pResource=src.Get();b.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;b.PlacedFootprint=layout;cmd->CopyTextureRegion(&a,0,0,0,&b,nullptr);barrier(cmd.Get(),dst,D3D12_RESOURCE_STATE_COPY_DEST,D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);uploads.push_back(src);};
