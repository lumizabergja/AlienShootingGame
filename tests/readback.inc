 Com<ID3D12DescriptorHeap>srv,rtv;D3D12_DESCRIPTOR_HEAP_DESC hd{};hd.Type=D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;hd.NumDescriptors=5;hd.Flags=D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;check(device->CreateDescriptorHeap(&hd,IID_PPV_ARGS(&srv)),"Test SRVs");hd.Type=D3D12_DESCRIPTOR_HEAP_TYPE_RTV;hd.NumDescriptors=1;hd.Flags=D3D12_DESCRIPTOR_HEAP_FLAG_NONE;check(device->CreateDescriptorHeap(&hd,IID_PPV_ARGS(&rtv)),"Test RTV");UINT step=device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);auto handle=srv->GetCPUDescriptorHandleForHeapStart();D3D12_SHADER_RESOURCE_VIEW_DESC rawDesc{};rawDesc.Format=DXGI_FORMAT_R32_TYPELESS;rawDesc.ViewDimension=D3D12_SRV_DIMENSION_BUFFER;rawDesc.Shader4ComponentMapping=D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;rawDesc.Buffer.NumElements=80*16/4;rawDesc.Buffer.Flags=D3D12_BUFFER_SRV_FLAG_RAW;device->CreateShaderResourceView(raw.Get(),&rawDesc,handle);for(auto t:{c0.Get(),c1.Get(),flow.Get(),cost.Get()}){handle.ptr+=step;D3D12_SHADER_RESOURCE_VIEW_DESC s{};s.Format=t->GetDesc().Format;s.ViewDimension=D3D12_SRV_DIMENSION_TEXTURE2D;s.Shader4ComponentMapping=D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;s.Texture2D.MipLevels=1;device->CreateShaderResourceView(t,&s,handle);}
 auto draw=[&](int pipeline,bool reset){auto target=texture(16,16,formats[pipeline],D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET,D3D12_RESOURCE_STATE_RENDER_TARGET);device->CreateRenderTargetView(target.Get(),nullptr,rtv->GetCPUDescriptorHandleForHeapStart());cmd->SetGraphicsRootSignature(root.Get());cmd->SetPipelineState(pipelines[pipeline].Get());ID3D12DescriptorHeap* heaps[]={srv.Get()};cmd->SetDescriptorHeaps(1,heaps);cmd->SetGraphicsRootDescriptorTable(0,srv->GetGPUDescriptorHandleForHeapStart());UINT constants[]={16,16,80,0,reset?1u:0u,16,16,0};cmd->SetGraphicsRoot32BitConstants(1,8,constants,0);auto rh=rtv->GetCPUDescriptorHandleForHeapStart();cmd->OMSetRenderTargets(1,&rh,FALSE,nullptr);D3D12_VIEWPORT vp{0,0,16,16,0,1};D3D12_RECT sc{0,0,16,16};cmd->RSSetViewports(1,&vp);cmd->RSSetScissorRects(1,&sc);cmd->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);cmd->DrawInstanced(3,1,0,0);barrier(cmd.Get(),target.Get(),D3D12_RESOURCE_STATE_RENDER_TARGET,D3D12_RESOURCE_STATE_COPY_SOURCE);auto desc=target->GetDesc();D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout{};UINT64 size{};device->GetCopyableFootprints(&desc,0,1,0,&layout,nullptr,nullptr,&size);auto readback=buffer(size,D3D12_HEAP_TYPE_READBACK,D3D12_RESOURCE_STATE_COPY_DEST);D3D12_TEXTURE_COPY_LOCATION a{},b{};a.pResource=readback.Get();a.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;a.PlacedFootprint=layout;b.pResource=target.Get();b.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;cmd->CopyTextureRegion(&a,0,0,0,&b,nullptr);flush();std::vector<uint8_t>out(16*16*4);void* data{};D3D12_RANGE range{0,SIZE_T(size)};check(readback->Map(0,&range,&data),"Readback map");for(UINT y=0;y<16;++y)memcpy(out.data()+y*64,(uint8_t*)data+layout.Offset+y*layout.Footprint.RowPitch,64);readback->Unmap(0,nullptr);return out;};
 auto unpack=draw(0,false);for(UINT y=0;y<16;++y)for(UINT x=0;x<16;++x){auto p=unpack.data()+(y*16+x)*4;require(p[0]==x*13&&p[1]==y*11&&p[2]==17&&p[3]==255,"BGRA conversion / padded pitch mismatch");}std::cout<<"GPU readback: BGRA channels and padded source pitch passed\n";
 auto vectors=draw(2,false);for(UINT i=0;i<256;++i){uint16_t v[2];memcpy(v,vectors.data()+i*4,4);require(v[0]==0xc400&&v[1]==0x4000,"Motion sign/scale or confidence shrank displacement");}std::cout<<"GPU readback: signed S10.5 -> (-4,+2) pixels, confidence preserves displacement passed\n";
 auto reset=draw(2,true);require(std::all_of(reset.begin(),reset.end(),[](uint8_t v){return v==0;}),"Reset did not clear motion");barrier(cmd.Get(),cost.Get(),D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,D3D12_RESOURCE_STATE_COPY_DEST);std::fill(costs.begin(),costs.end(),255);upload(cost.Get(),costs,4);flush();uploads.clear();auto rejected=draw(2,false);require(std::all_of(rejected.begin(),rejected.end(),[](uint8_t v){return v==0;}),"Invalid confidence not rejected");std::cout<<"GPU readback: reset and invalid confidence rejection passed\n";
