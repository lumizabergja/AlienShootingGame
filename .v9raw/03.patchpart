        result = deviceFn(d);
+    } catch (...) {
+        if (hooked) { MH_DisableHook(setter); MH_RemoveHook(setter); }
+        if (mhOwned) MH_Uninitialize();
+        gOriginalParamSetPointer = nullptr;
+        throw;
+    }
+
+    if (hooked) { MH_DisableHook(setter); MH_RemoveHook(setter); }
+    if (mhOwned) MH_Uninitialize();
+    gOriginalParamSetPointer = nullptr;
+
+    compute = gPublishedCompute.exchange(nullptr, std::memory_order_acq_rel);
+    bootstrapStatus += ", parameter set(void*) calls=" +
+                       std::to_string(gParamSetCalls.load(std::memory_order_relaxed)) +
+                       ", compute publish=" + (compute ? std::string("captured") : std::string("missing"));
+
+    ck(result, "Set Streamline device");
+    if (!compute)
+        throw std::runtime_error("V9 did not observe sl.common publishing sl.param.common.computeAPI: " + bootstrapStatus);
+}
+
 void FrameGeneration::configure(IDXGIAdapter1 *a, UINT w, UINT h, UINT multiplier, bool vsync) {
     width = w;
     height = h;
