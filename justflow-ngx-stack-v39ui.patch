diff --git a/src/v39_ui_frontend.cpp b/src/v39_ui_frontend.cpp
new file mode 100644
index 0000000..eadd901
--- /dev/null
+++ b/src/v39_ui_frontend.cpp
@@ -0,0 +1,267 @@
+// Experimental V39-style control panel for the direct-NGX feasibility engine.
+// Preserves V39's control geometry and controls JustFlow's isolated test process.
+// It does NOT claim to provide V39's NvFBC PID capture or cost-output support.
+#define UNICODE
+#define _UNICODE
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <commctrl.h>
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr wchar_t kWndClass[] = L"V39NativeControlsNgxExperiment";
+constexpr wchar_t kWndTitle[] = L"V39 Controls | Experimental NGX DLSS-G + NVIDIA Frame Warp";
+enum { IDC_TARGET = 2001, IDC_REFRESH, IDC_MULTIPLIER, IDC_NVOF_RESOLUTION, IDC_START, IDC_STOP, IDC_STATUS };
+
+std::wstring ExeDir()
+{
+    wchar_t p[MAX_PATH] = {};
+    GetModuleFileNameW(nullptr, p, MAX_PATH);
+    return std::filesystem::path(p).parent_path().wstring();
+}
+std::string Utf8(const std::wstring& text)
+{
+    int n = WideCharToMultiByte(CP_UTF8, 0, text.data(), (int)text.size(), nullptr, 0, nullptr, nullptr);
+    std::string v((size_t)n, '\0');
+    if (n) WideCharToMultiByte(CP_UTF8, 0, text.data(), (int)text.size(), v.data(), n, nullptr, nullptr);
+    return v;
+}
+std::wstring CleanTitle(std::wstring title)
+{
+    for (wchar_t& c : title) if (c == L'\r' || c == L'\n' || c == L'=' || c == L'[' || c == L']') c = L' ';
+    return title;
+}
+
+class V39ControlPanel
+{
+public:
+    int Run(HINSTANCE instance)
+    {
+        hinst = instance;
+        SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+        WNDCLASSEXW wc{sizeof wc};
+        wc.hInstance = hinst;
+        wc.lpfnWndProc = &V39ControlPanel::WindowProc;
+        wc.hCursor = LoadCursorW(nullptr, IDC_ARROW);
+        wc.hIcon = LoadIconW(nullptr, IDI_APPLICATION);
+        wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
+        wc.lpszClassName = kWndClass;
+        if (!RegisterClassExW(&wc)) return 1;
+        hwnd = CreateWindowExW(WS_EX_APPWINDOW, kWndClass, kWndTitle,
+            WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX,
+            CW_USEDEFAULT, CW_USEDEFAULT, 600, 405, nullptr, nullptr, hinst, this);
+        if (!hwnd) return 2;
+        CreateControls();
+        ShowWindow(hwnd, SW_SHOW);
+        UpdateWindow(hwnd);
+        RegisterHotKey(hwnd, 1, MOD_NOREPEAT, VK_F10);
+        MSG m{};
+        while (GetMessageW(&m, nullptr, 0, 0) > 0) { TranslateMessage(&m); DispatchMessageW(&m); }
+        Stop();
+        return (int)m.wParam;
+    }
+private:
+    HINSTANCE hinst = nullptr;
+    HWND hwnd = nullptr, target_combo = nullptr, status = nullptr;
+    PROCESS_INFORMATION child{};
+    bool running = false;
+
+    HWND Label(const wchar_t* s, int x, int y, int w, int h)
+    {
+        return CreateWindowW(L"STATIC", s, WS_CHILD | WS_VISIBLE, x, y, w, h,
+            hwnd, nullptr, hinst, nullptr);
+    }
+    void CreateControls()
+    {
+        InitCommonControls();
+        Label(L"Game", 18, 16, 70, 22);
+        target_combo = CreateWindowW(WC_COMBOBOXW, nullptr,
+            WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL,
+            18, 40, 440, 240, hwnd, (HMENU)IDC_TARGET, hinst, nullptr);
+        CreateWindowW(L"BUTTON", L"Refresh", WS_CHILD | WS_VISIBLE,
+            468, 39, 105, 28, hwnd, (HMENU)IDC_REFRESH, hinst, nullptr);
+
+        Label(L"FG multiplier", 18, 86, 95, 22);
+        HWND multiplier = CreateWindowW(WC_COMBOBOXW, nullptr,
+            WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL,
+            120, 81, 120, 150, hwnd, (HMENU)IDC_MULTIPLIER, hinst, nullptr);
+        for (const wchar_t* option : {L"Off", L"2x", L"3x", L"4x", L"5x", L"6x"})
+            SendMessageW(multiplier, CB_ADDSTRING, 0, (LPARAM)option);
+        SendMessageW(multiplier, CB_SETCURSEL, 1, 0);
+
+        Label(L"Motion resolution", 260, 86, 117, 22);
+        HWND of_res = CreateWindowW(WC_COMBOBOXW, nullptr,
+            WS_CHILD | WS_VISIBLE | CBS_DROPDOWNLIST | WS_VSCROLL,
+            375, 81, 198, 160, hwnd, (HMENU)IDC_NVOF_RESOLUTION, hinst, nullptr);
+        for (const wchar_t* option : {L"10%", L"25%", L"50%", L"100%"})
+            SendMessageW(of_res, CB_ADDSTRING, 0, (LPARAM)option);
+        SendMessageW(of_res, CB_SETCURSEL, 0, 0);
+
+        Label(L"Motion: NVIDIA Optical Flow Accelerator 4x4 FAST", 18, 127, 420, 24);
+        Label(L"Confidence: camera-fit gate ON", 385, 127, 192, 24);
+        Label(L"DXGI capture (test)  |  DX12  |  Genuine NVIDIA Frame Warp", 18, 169, 560, 22);
+
+        CreateWindowW(L"BUTTON", L"START", WS_CHILD | WS_VISIBLE | BS_DEFPUSHBUTTON,
+            18, 206, 180, 38, hwnd, (HMENU)IDC_START, hinst, nullptr);
+        CreateWindowW(L"BUTTON", L"STOP", WS_CHILD | WS_VISIBLE | WS_DISABLED,
+            210, 206, 120, 38, hwnd, (HMENU)IDC_STOP, hinst, nullptr);
+        status = Label(L"Select a game, FG multiplier and motion resolution, then Start.", 18, 258, 555, 52);
+        Label(L"F10 stops  |  Strict camera-fit confidence  |  Warp limit: 2 pixels", 18, 331, 555, 22);
+        RefreshTargets();
+        SetTimer(hwnd, 2, 750, nullptr);
+    }
+    static BOOL CALLBACK Enumerate(HWND candidate, LPARAM userdata)
+    {
+        V39ControlPanel* self = reinterpret_cast<V39ControlPanel*>(userdata);
+        if (!IsWindowVisible(candidate) || candidate == self->hwnd) return TRUE;
+        DWORD pid = 0;
+        GetWindowThreadProcessId(candidate, &pid);
+        if (!pid || pid == GetCurrentProcessId()) return TRUE;
+        if (GetWindowLongPtrW(candidate, GWL_EXSTYLE) & WS_EX_TOOLWINDOW) return TRUE;
+        wchar_t title[512]{};
+        GetWindowTextW(candidate, title, 512);
+        if (!title[0]) return TRUE;
+        wchar_t entry[640]{};
+        swprintf_s(entry, L"%s  [PID %lu]", title, pid);
+        const LRESULT pos = SendMessageW(self->target_combo, CB_ADDSTRING, 0, (LPARAM)entry);
+        SendMessageW(self->target_combo, CB_SETITEMDATA, pos, (LPARAM)candidate);
+        if (std::wstring(title).find(L"Counter-Strike") != std::wstring::npos ||
+            std::wstring(title).find(L"League of Legends") != std::wstring::npos)
+            SendMessageW(self->target_combo, CB_SETCURSEL, pos, 0);
+        return TRUE;
+    }
+    void RefreshTargets()
+    {
+        SendMessageW(target_combo, CB_RESETCONTENT, 0, 0);
+        EnumWindows(Enumerate, (LPARAM)this);
+        if (SendMessageW(target_combo, CB_GETCURSEL, 0, 0) == CB_ERR &&
+            SendMessageW(target_combo, CB_GETCOUNT, 0, 0) > 0)
+            SendMessageW(target_combo, CB_SETCURSEL, 0, 0);
+    }
+    void SetRunning(bool is_running)
+    {
+        running = is_running;
+        for (int id : {IDC_TARGET, IDC_REFRESH, IDC_MULTIPLIER, IDC_NVOF_RESOLUTION, IDC_START})
+            EnableWindow(GetDlgItem(hwnd, id), !running);
+        EnableWindow(GetDlgItem(hwnd, IDC_STOP), running);
+    }
+    void Start()
+    {
+        if (running) return;
+        LRESULT selected = SendMessageW(target_combo, CB_GETCURSEL, 0, 0);
+        if (selected == CB_ERR) { SetWindowTextW(status, L"Select the game window first."); return; }
+        HWND target = (HWND)SendMessageW(target_combo, CB_GETITEMDATA, selected, 0);
+        if (!IsWindow(target)) { RefreshTargets(); SetWindowTextW(status, L"Game closed. Refresh and select again."); return; }
+        wchar_t raw_title[512]{};
+        GetWindowTextW(target, raw_title, 512);
+        const std::wstring game_title = CleanTitle(raw_title);
+        const LRESULT mi = SendDlgItemMessageW(hwnd, IDC_MULTIPLIER, CB_GETCURSEL, 0, 0);
+        const LRESULT ri = SendDlgItemMessageW(hwnd, IDC_NVOF_RESOLUTION, CB_GETCURSEL, 0, 0);
+        if (mi < 0 || mi > 5 || ri < 0 || ri > 3) { SetWindowTextW(status, L"Choose valid FG and motion options."); return; }
+        const int multiplier = mi == 0 ? 1 : (int)mi + 1;
+        const int percents[] = {10, 25, 50, 100};
+        RECT rect{};
+        if (!GetClientRect(target, &rect)) { SetWindowTextW(status, L"Game resolution unavailable."); return; }
+        int w = (int)(rect.right - rect.left), h = (int)(rect.bottom - rect.top);
+        if (w < 320 || h < 240) { SetWindowTextW(status, L"Select an open game window, not a launcher."); return; }
+        w = std::max(64, ((w * percents[ri] / 100 + 7) / 8) * 8);
+        h = std::max(64, ((h * percents[ri] / 100 + 7) / 8) * 8);
+
+        const std::filesystem::path dir = ExeDir();
+        const auto engine = dir / L"justflow.exe";
+        const auto dlss = dir / L"nvngx_dlssg.dll";
+        const auto warp = dir / L"nvngx_latewarp.dll";
+        if (!std::filesystem::exists(engine) || !std::filesystem::exists(dlss) || !std::filesystem::exists(warp))
+        {
+            SetWindowTextW(status, L"Missing engine or NVIDIA signed runtime DLLs beside this EXE."); return;
+        }
+        const auto profile = dir / L"profiles" / L"v39_ui_active.ini";
+        std::ofstream out(profile, std::ios::binary | std::ios::trunc);
+        if (!out) { SetWindowTextW(status, L"Cannot write the experimental game profile."); return; }
+        out << "[capture]\nmode=dda\nwindow_title=" << Utf8(game_title)
+            << "\nwindow_class=\ncursor=0\nborder=0\n\n"
+            << "[nr]\nwork=1920x1080\nmax_fps=0\n\n"
+            << "[filters]\nsharpen=0\nsaturation=1\n\n"
+            << "[ofa]\ninput=" << w << "x" << h << "\ngrid=4\nzero_below=0.5\n\n"
+            << "[ui]\nmask=0\nfeather=0\n\n"
+            << "[fg]\nengine=dlssg\nmultiplier=" << multiplier
+            << "\npacing=vblank\nlw_fov=60\nmin_gain=0\nmax_input_fps=0\n\n"
+            << "[log]\nfile=v39-ui-ngx-framewarp.log\n";
+        out.close();
+        SetEnvironmentVariableW(L"JF_NGX_STACK_LW", L"1");
+        std::wstring cmd = L"\"" + engine.wstring() + L"\" --ini \"" + profile.wstring() + L"\"";
+        STARTUPINFOW si{sizeof si};
+        if (!CreateProcessW(engine.c_str(), cmd.data(), nullptr, nullptr, FALSE,
+            CREATE_NO_WINDOW, nullptr, dir.c_str(), &si, &child))
+        {
+            SetWindowTextW(status, L"Experimental NGX engine failed to launch. Check Windows security.");
+            return;
+        }
+        SetRunning(true);
+        SetWindowTextW(status, L"NGX experimental engine started. Calibrating NvOFA + mouse; see v39-ui-ngx-framewarp.log for TRUE Frame Warp state.");
+    }
+    void Stop()
+    {
+        if (!running) return;
+        // Only the specific child we started can be stopped; no game process is touched.
+        if (child.hProcess)
+        {
+            PostThreadMessageW(child.dwThreadId, WM_QUIT, 0, 0);
+            if (WaitForSingleObject(child.hProcess, 1200) == WAIT_TIMEOUT)
+                TerminateProcess(child.hProcess, 0);
+            CloseHandle(child.hProcess);
+            CloseHandle(child.hThread);
+            child = {};
+        }
+        SetRunning(false);
+        SetWindowTextW(status, L"Stopped. Your game remains untouched. Select options and Start to test again.");
+    }
+    void Poll()
+    {
+        if (running && child.hProcess && WaitForSingleObject(child.hProcess, 0) == WAIT_OBJECT_0)
+        {
+            CloseHandle(child.hProcess);
+            CloseHandle(child.hThread);
+            child = {};
+            SetRunning(false);
+            SetWindowTextW(status, L"NGX engine stopped or failed. Open v39-ui-ngx-framewarp.log to see the real result.");
+        }
+    }
+    static LRESULT CALLBACK WindowProc(HWND win, UINT msg, WPARAM wparam, LPARAM lparam)
+    {
+        V39ControlPanel* self = (V39ControlPanel*)GetWindowLongPtrW(win, GWLP_USERDATA);
+        if (msg == WM_NCCREATE)
+        {
+            self = (V39ControlPanel*)((CREATESTRUCTW*)lparam)->lpCreateParams;
+            SetWindowLongPtrW(win, GWLP_USERDATA, (LONG_PTR)self);
+        }
+        if (!self) return DefWindowProcW(win, msg, wparam, lparam);
+        switch (msg)
+        {
+        case WM_COMMAND:
+            switch (LOWORD(wparam))
+            {
+            case IDC_REFRESH: self->RefreshTargets(); return 0;
+            case IDC_START: self->Start(); return 0;
+            case IDC_STOP: self->Stop(); return 0;
+            }
+            break;
+        case WM_HOTKEY: if (wparam == 1) { self->Stop(); return 0; } break;
+        case WM_TIMER: if (wparam == 2) { self->Poll(); return 0; } break;
+        case WM_DESTROY: self->Stop(); PostQuitMessage(0); return 0;
+        }
+        return DefWindowProcW(win, msg, wparam, lparam);
+    }
+};
+}
+
+int WINAPI wWinMain(HINSTANCE instance, HINSTANCE, PWSTR, int)
+{
+    V39ControlPanel panel;
+    return panel.Run(instance);
+}
